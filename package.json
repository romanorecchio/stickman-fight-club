{
  "name": "stickman-fight-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json --noEmit && npm run build -w @sfc/client && node scripts/build-server.mjs && SFC_SMOKE=1 node packages/server/dist/index.js",
    "start": "node packages/server/dist/index.js",
    "test": "vitest run",
    "headless": "SFC_SMOKE=1 node packages/server/dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
